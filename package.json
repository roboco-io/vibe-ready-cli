{
  "name": "vibe-ready",
  "version": "0.4.1",
  "description": "Analyze how ready your repository is for vibe coding (AI-assisted development)",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vibe-ready": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
