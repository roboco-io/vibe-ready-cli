    "claude-code-sdk"
  ],
  "author": "roboco-io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/roboco-io/vibe-ready-cli.git"
  },
  "homepage": "https://github.com/roboco-io/vibe-ready-cli",
  "bugs": {
    "url": "https://github.com/roboco-io/vibe-ready-cli/issues"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "chalk": "^5.4.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "husky": "^9.1.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
