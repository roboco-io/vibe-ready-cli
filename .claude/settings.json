{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npx tsx src/index.ts*)",
      "Bash(node dist/index.js*)",
      "Bash(ls *)",
      "Bash(git *)"
    ]
  },
  "hooks": {
    "PreCommit": [
      {
        "type": "command",
        "command": "cd /Users/dohyunjung/Workspace/roboco-io/tools/vibe-ready-cli && npm run build && npm test"
      }
    ]
  }
}
